# MeraSEP — environment variables

# Leave empty to use the bundled mock data at public/mock/events.json.
# Paste any URL that returns the event list (a plain array, { "data": [...] }
# or { "events": [...] }) to load that data everywhere with no code change.
NEXT_PUBLIC_API_URL=

# Reserved for the BetterAuth wiring. The frontend does not read these yet.
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000
# MONGODB_URI=
